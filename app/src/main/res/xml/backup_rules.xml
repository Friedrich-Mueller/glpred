<?xml version="1.0" encoding="utf-8"?>
<!--
  The pre-Android-12 counterpart to data_extraction_rules.xml.

  `allowBackup="false"` already stops both backup and restore on these API levels, so nothing here is
  ever consulted in the app as it stands. It exists for two reasons: lint requires a fullBackupContent
  target alongside dataExtractionRules for a minSdk of 26, and if `allowBackup` is ever flipped back on,
  these exclusions keep every domain - diary.db, its -wal and -shm companions, cgm.db and the
  SharedPreferences stores - off the backup transport.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="file" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
